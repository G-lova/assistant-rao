                },
                "detected_type": {
                    "type": "string",
                    "enum": "ALLOWED_DOC_TYPES",
                    "description": "Один из ключей словаря или 'docDopMaterialsFiles'"
                },
                "issues": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "description": "Тип проблемы (например, 'ожидался проект контракта, но в документе — техническое задание' или 'не удалось определить тип: пустой документ')"
                    },
                    "description": "Проблемы соответствия или распознавания типа документа"
                },
                "confidence": {
                    "type": "number",
                    "minimum": 0.0,
                    "maximum": 1.0,
