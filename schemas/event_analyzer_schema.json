{
    "type": "object",
    "required": ["event_summary", "significance", "risks", "confidence"],
    "properties": {
        "event_summary": {"type": "string", "description": "Краткое описание события."},
        "significance": {"type": "number", "minimum": 0, "maximum": 1, "description": "Значимость события для риск-мониторинга."},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "changes": {
            "type": "array",
            "default": [],
            "items": {
                "type": "object",
                "required": ["change_type", "description", "severity"],
                "properties": {
                    "change_type": {"type": "string"},
                    "description": {"type": "string"},
                    "old_value": {"type": ["string", "null"]},
                    "new_value": {"type": ["string", "null"]},
                    "severity": {"type": "number", "minimum": 0, "maximum": 1},
                    "change_justification": {"type": ["string", "null"]}
                }
            }
        },
        "risks": {
            "type": "array",
            "default": [],
            "items": {
                "type": "object",
                "required": ["rule_id", "title", "description", "level", "confidence", "verification_needed"],
                "properties": {
                    "rule_id": {"type": "string", "enum": "EVENT_RISKS_KEYS", "description": "Код риска из справочника."},
                    "title": {"type": "string"},
                    "description": {"type": "string"},
                    "level": {"type": "number", "minimum": 0, "maximum": 1},
                    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
                    "law": {"type": ["string", "null"]},
                    "verification_needed": {"type": "array", "items": {"type": "string"}}
                }
            }
        }
    }
}
