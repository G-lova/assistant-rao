{
    "type": "object",
    "required": [
        "summary",
        "risks"
    ],
    "properties": {
        "summary": {
            "type": "string",
            "description": "Краткий вывод по фрагменту документа"
        },
        "risks": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "code",
                    "severity",
                    "title",
                    "explanation",
                    "requirement_source",
                    "evidence"
                ],
                "properties": {
                    "code": {
                        "type": "string",
                        "enum": "RISK_CODES",
                        "description": "Код риска из каталога (список подставляется из risk_monitoring/risk_catalog.py)"
                    },
                    "severity": {
                        "type": "string",
                        "enum": [
                            "low",
                            "medium",
                            "high"
                        ]
                    },
                    "title": {
                        "type": "string"
                    },
                    "explanation": {
                        "type": "string"
                    },
                    "requirement_source": {
                        "type": "string",
                        "enum": [
                            "закон",
                            "заказчик",
                            "неясно"
                        ],
                        "description": "Кто установил требование или условие из цитаты: «закон» — прямо следует из закона или подзаконного акта (44-ФЗ, 223-ФЗ, КоАП, Градостроительный кодекс, постановления Правительства, указы), «заказчик» — установлено заказчиком сверх закона, «неясно»"
                    },
                    "law": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "description": "Нормативное основание"
                    },
                    "verification_needed": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "description": "Действия эксперта для подтверждения или опровержения"
                    },
                    "evidence": {
                        "type": "object",
                        "required": [
                            "fragment",
                            "confidence"
                        ],
                        "properties": {
                            "fragment": {
                                "type": "string"
                            },
                            "section": {
                                "type": [
                                    "string",
                                    "null"
                                ]
                            },
                            "page": {
                                "type": [
                                    "integer",
                                    "null"
                                ]
                            },
                            "confidence": {
                                "type": "number",
                                "minimum": 0,
                                "maximum": 1
                            }
                        }
                    }
                }
            }
        }
    }
}